# Supabase — get values from: Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key

# Supabase service-role key — server-only, never exposed to the client bundle.
# Local dev: copy to .dev.vars (read by @cloudflare/vite-plugin in workerd SSR environment)
# Production: run `wrangler secret put SUPABASE_SECRET_KEY`
# NOT inlined by Vite at build time — workerd provides it at runtime from Worker bindings.
SUPABASE_SECRET_KEY=your-service-role-key

# Google Calendar OAuth — server-only values used by the Worker to connect and refresh Calendar access.
# Use the same Google OAuth client configured for the direct Calendar connect flow.
# Local dev: copy to .dev.vars. Production: set with `wrangler secret put`.
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_TOKEN_ENCRYPTION_KEY=generate-a-long-random-secret

# Postgres direct connection (already exists in .env.local)
VITE_SUPABASE_DATABASE_URL=postgresql://...
